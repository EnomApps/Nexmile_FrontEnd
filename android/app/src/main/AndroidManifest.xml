<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nexmile talks to the delivery backend over the network. -->
    <uses-permission
        android:name="android.permission.INTERNET"/>
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Delivery is limited to a 1 km radius and the API makes latitude and
         longitude mandatory on an address, so the address book needs a fix on
         the customer's position. Foreground only — Nexmile never tracks a
         customer in the background. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Voice search only. Recognition runs on the device's own recogniser;
         Nexmile never records audio itself and never uploads any. -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Order updates. Android 13 and later need the customer to say yes;
         earlier versions grant it at install with no dialog. Asked for at the
         point there is an order to notify about, not at launch. -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="Nexmile"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The channel a notification lands in when the server sends one
             without naming a channel. Must match kOrdersChannelId in
             lib/core/push/push_service.dart — a mismatch is silent: Android
             drops the notification with no log line. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="nexmile_orders"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action
                android:name="android.intent.action.PROCESS_TEXT"/>
            <data
                android:mimeType="text/plain"/>
        </intent>
        <!-- Voice search. Android 11 and later hide other packages unless
             they are declared here, so without this the speech recogniser is
             reported as simply unavailable rather than failing loudly. -->
        <intent>
            <action
                android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>